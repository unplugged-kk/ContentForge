# ContentForge local configuration
NODE_ENV=development
DATABASE_URL=postgres://cfuser:cfpass@localhost:5432/contentforge
# NOTE (VPS / docker compose): the compose stack supplies DATABASE_URL to the app
# itself (the compose Postgres service), so the value in this file is IGNORED by
# that deployment. Do not leave a *different* live database URL here — a script,
# admin task or migration run that sources this file would silently talk to the
# wrong database. Keep only the value the app truly uses.
# REQUIRED in production: the server refuses to boot with the dev default
# (fail-closed since Phase 30). Set a long random value via Railway variables
# or your host env; never commit the real value.
SESSION_SECRET=change-me

# Encryption key for secrets at rest (connected_accounts.access_token and
# refresh_token are encrypted with AES-256-GCM). Base64, 32 bytes.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# If unset, the server derives a key from SESSION_SECRET via scrypt. That's
# fine for local dev but DO NOT rely on it in production — rotating
# SESSION_SECRET would silently invalidate every stored token. Set a
# dedicated ENCRYPTION_KEY in prod and keep it stable across deploys.
# ENCRYPTION_KEY=

# xQuick posting provider
# Docs: https://docs.xquik.com/api-reference/overview
XQUIK_API_BASE_URL=https://xquik.com/api/v1
XQUIK_API_KEY=xq_YOUR_KEY_HERE
XQUIK_ACCOUNT=your_x_username_or_xquik_account_id

# Optional publishing behavior
X_THREAD_FINISHER=
XQUIK_TIMEOUT_MS=30000
XQUIK_WRITE_POLL_ATTEMPTS=6
XQUIK_WRITE_POLL_DELAY_MS=2000
XQUIK_ALLOW_WRITE_RETRIES=0

# Optional: if you later wire xQuick read/analytics endpoints for ingest/metrics.
XQUIK_TWEET_LOOKUP_ENDPOINT=/x/tweets/{id}
XQUIK_TWEET_TEXT_PATH=
XQUIK_ANALYTICS_ENDPOINT=

# Media providers. Provider IDs/models/voices are public capability metadata;
# credentials and base URLs remain server-only.
VIDEO_FACTORY_ROOT=
VIDEO_FACTORY_DASHBOARD_URL=http://127.0.0.1:4300/manifest.json
OPENSHORTS_API_URL=http://127.0.0.1:8000

# Development-machine TTS proof (macOS only; no cloud credential).
MACOS_SAY_ENABLED=false
AUDIO_PROVIDER_ID=macos-say
MACOS_SAY_VOICES=Samantha,Daniel

# Cloud media providers — put real secrets in local `.env` only (gitignored).
# Adapters read process.env; keys are never hardcoded in source.
# Nano Banana (Gemini images) — the images-capable provider. Registered as
# `gemini-image`; selected per request via providerId (or VISUAL_PROVIDER_ID for
# the fixture id). It calls the native generateContent endpoint and returns the
# image inline, so it works even when the AI gateway exposes no images API.
# Paid: it is behind the paid-media gate below.
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
# GEMINI_IMAGE_SIZE=1K            # 1K | 2K | 4K (optional)
# GEMINI_NATIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_IMAGE_TIMEOUT_MS=120000
# Paid-media gate. Required for ANY paid media generation (fal, ElevenLabs, and
# now gemini-image). Keep it OFF unless you intend to spend.
# CONTENTFORGE_ALLOW_PAID_MEDIA=1
# Paid generate() stays blocked unless CONTENTFORGE_REAL_MEDIA_E2E=1 and
# CONTENTFORGE_MEDIA_CERTIFICATION=1 (or CONTENTFORGE_ALLOW_PAID_MEDIA=1).
FAL_KEY=
ELEVENLABS_API_KEY=
# Optional aliases also accepted: FAL_API_KEY, ELEVEN_API_KEY, XI_API_KEY
# Optional pins after discovery (cert script can discover if empty):
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
FAL_MODEL_ID=fal-ai/wan/v2.2-a14b/text-to-video
MEDIA_CERT_MAX_ELEVENLABS_CALLS=1
MEDIA_CERT_MAX_FAL_CALLS=1
# Leave these off in normal .env — enable only for the one-shot certify script:
# CONTENTFORGE_REAL_MEDIA_E2E=1
# CONTENTFORGE_MEDIA_CERTIFICATION=1

# YouTube publishing (Phase 28.1 / 28.1B) — ChannelAdapter + Google OAuth.
# Reuses GOOGLE_CLIENT_ID/SECRET when YOUTUBE_* client vars are empty.
# Register exact redirect in Google Cloud Console (Web client), e.g.:
#   http://localhost:5000/api/social/youtube/callback
# Connect via Settings → Connect YouTube (GET /api/social/youtube/connect).
# Scopes: youtube.upload + youtube.readonly; access_type=offline for refresh.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_CALLBACK_URL=http://localhost:5000/api/social/youtube/callback
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_ACCESS_TOKEN=
# YOUTUBE_DEFAULT_PRIVACY=private
# Real publish gate (manual / opt-in only — never set in CI):
# CONTENTFORGE_REAL_PUBLISH_E2E=1
# CONTENTFORGE_PUBLISH_CERTIFICATION=1
# MEDIA_CERT_MAX_YOUTUBE_PUBLISHES=1
# npx tsx script/publish-certify-youtube.ts

# ── Cloudflare Tunnel ingress (VPS deployment) ──────────────
# Cloudflare is used for DNS + Tunnel + HTTPS ingress only — the app stays a
# plain Docker Compose stack (no Workers/D1/R2). Create the tunnel in
# Cloudflare Zero Trust → Networks → Tunnels, route your hostname to
# http://app:5000, and paste the tunnel token below. Then start with:
#   docker compose --profile tunnel up -d
# TUNNEL_TOKEN=
# PUBLIC_HOSTNAME=contentforge.example.com

# ── Hardening (single-operator) ──────────────────────────────
# Close public sign-up (recommended once the operator account exists).
# REGISTRATION_DISABLED=1
# Trust one reverse-proxy hop (Cloudflare Tunnel) so req.secure / req.ip are
# correct and a Secure session cookie is set when TLS ends at the edge.
# TRUST_PROXY=1

# ── Task-aware AI routing ────────────────────────────────────
# The default provider (AI_BASE_URL/AI_API_KEY) serves every non-video task.
# Gemini is used only for video/transcript tasks. If GEMINI_API_KEY is unset,
# video tasks fall back to the default provider (never a hard failure).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY=
# VIDEO_MAIN_MODEL=gemini-3.8-flash           # video: the one video task (extraction)

# ── Jev (TypeSafe "System One") — bounded decisions ──────────
# Typed questions (noul/choice/score) returning probabilities. Used at decision
# boundaries only (research triage, opportunity signals, content gate).
# Transport: `api` with a key, or `cli` via headless `cmd -m typesafe/jev`.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_TRANSPORT=auto
# JEV_TRIAGE_PURSUE=0.65
# JEV_TRIAGE_WATCH=0.45
# Gate the research pipeline: only Jev-approved sources continue to evidence.
# JEV_RESEARCH_GATE=1
# Bounded framing: let Jev narrow an automation policy's allowed formats to the
# one that best fits the derived Story (narrow-only; fail-open).
# JEV_FRAMING=1
# ── Decision OS ──────────────────────────────────────────────────────────────
# Master switch for the centralized decision layer. Off by default: with it off
# every boundary behaves exactly as it does without the decision layer.
# NOTE: every per-decision flag below ALSO requires this master switch. With the
# master off a boundary is not wired at all (rather than wired-but-inert), so
# enabling a per-decision flag alone changes nothing.
# JEV_DECISION_ENGINE_ENABLED=1
# Which triage verdicts survive to evidence: "pursue+watch" (default) or "pursue".
# JEV_TRIAGE_KEEP=pursue+watch
# Depth selection: asked only when a request specifies no depth. Separate flag so
# it never activates as a side effect of the triage gate.
# JEV_RESEARCH_DEPTH=1
# Opportunity score band thresholds (deterministic composition of Jev signals).
# JEV_OPPORTUNITY_HIGH=0.66
# JEV_OPPORTUNITY_MEDIUM=0.4
# Quality-gate thresholds (approve / revise) and publish-gate thresholds
# (publish / reject) — the deterministic cut-offs the gates apply.
# JEV_QUALITY_APPROVE=0.7
# JEV_QUALITY_REVISE=0.45
# JEV_PUBLISH_APPROVE=0.7
# JEV_PUBLISH_REJECT=0.35
# Per-decision flags (phases 3+; each also requires the master switch).
# JEV_OPPORTUNITY_SCORE=1
# JEV_CONTENT_STRATEGY=1
# JEV_CONTENT_GATE=1
# JEV_EXPERTISE=1
# JEV_AGENT_REACH_DECISION=1
# JEV_PUBLISH_GATE=1
# Legacy scoring shadow (JC-01): /api/viral/score keeps its own answer while the
# decision layer records what IT would have scored, for comparison before any
# cut-over. Off ⇒ no extra call at all.
# JEV_LEGACY_SCORING=1
# Video research provider: durable video URLs to ingest as research sources.
# VIDEO_RESEARCH_URLS=
# Opt-in Gemini video-understanding fallback for videos with no captions
# (video-token priced — leave off unless you need it).
# VIDEO_GEMINI_FALLBACK=1

# ── Google OAuth (YouTube connect) ───────────────────────────
# YOUTUBE_CLIENT_ID/SECRET fall back to these when unset.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── LinkedIn ─────────────────────────────────────────────────
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:person:xxxxxxxx
# LINKEDIN_API_VERSION=202609        # must be a current YYYYMM; never pinned in code
# LINKEDIN_API_BASE_URL=https://api.linkedin.com
# LINKEDIN_TIMEOUT_MS=30000

# ── Threads ──────────────────────────────────────────────────
# Short-lived tokens are exchanged for long-lived ones and refreshed near
# expiry (7-day threshold, 60-day lifetime) before a post is attempted.
# THREADS_ACCESS_TOKEN=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# THREADS_USER_ID=
# THREADS_API_VERSION=v1.0
# THREADS_API_BASE_URL=https://graph.threads.net
# THREADS_AUTHORIZE_URL=https://threads.net/oauth/authorize
# THREADS_REDIRECT_URI=http://localhost:5000/api/social/threads/callback
# THREADS_TIMEOUT_MS=30000

# ── Instagram (media publishing) ─────────────────────────────
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# INSTAGRAM_APP_ID=
# INSTAGRAM_API_VERSION=v25.0
# INSTAGRAM_API_BASE_URL=https://graph.facebook.com
# INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/social/instagram/callback
# INSTAGRAM_MEDIA_STAGE_URL=
# INSTAGRAM_CONTAINER_POLL_ATTEMPTS=20
# INSTAGRAM_CONTAINER_POLL_GAP_MS=3000
# INSTAGRAM_TIMEOUT_MS=30000

# ── Local storage / media paths ──────────────────────────────
# UPLOADS_DIR=uploads                        # user uploads (docker volume)
# VISUAL_ASSET_DIR=uploads/visual-assets     # generated asset BYTES (durable; F3)
# YTDLP_PATH=yt-dlp                          # caption fetch binary
# CONTENTFORGE_PUBLIC_BASE_URL=https://your.host
#   Required to mint provider-fetch URLs (GET /api/provider-media/:token).

# ── Research providers (discovery) ───────────────────────────
# REDDIT_SUBREDDITS=programming,devops
# REDDIT_DEFAULT_LIMIT=25
# HN_TAGS=story,ask_hn
# HN_DEFAULT_LIMIT=25
# WEB_RESEARCH_URLS=
# WEB_DEFAULT_LIMIT=10
# VIDEO_DEFAULT_LIMIT=10
# YOUTUBE_CHANNEL_IDS=
# YOUTUBE_DEFAULT_LIMIT=10
# YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
# OPENSEO_API_KEY=
# OPENSEO_API_URL=
# OPENSEO_MCP_URL=
# LAST30DAYS_ENABLED=1
# LAST30DAYS_SCRIPT=last30days

# ── Test-harness only (never set in a deployment) ────────────
# The E2E suites read their own knobs and are documented at the point of use:
#   E2E_*_DATABASE_URL, E2E_*_APP_PORT, TEST_DATABASE_URL, PLAYWRIGHT_BASE_URL,
#   DISABLE_* (scheduler toggles), MEDIA_CERT_*, PUBLISH_CERT_*,
#   CONTENTFORGE_E2E_SERVER, SEED_DEMO_DATA, OPENSHORTS_*, RESUME_*, AUDIT_*.
# See script/e2e-*.mjs and docs/DOGFOODING.md. Do not set them in production.
