    "views": [
      { "id": "run", "label": "A discovery run", "focus": ["cron", "fanout", "dedupe", "rank", "ideas"], "note": "Fetch sources, dedupe 14 days, then let the model rank exactly 20 ideas." },
      { "id": "autopost", "label": "RSS autopost", "focus": ["ideas", "rss", "draftgen", "posts"], "note": "Ideas matching an autopost feed become drafts, at most two per feed." },
      { "id": "empty", "label": "Empty fetch", "focus": ["fanout", "seed", "rank"], "note": "If nothing is fetched, three fallback ideas are seeded." }
