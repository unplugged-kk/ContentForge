  ],
  "phases": [
    { "id": "fetch", "label": "Fetch", "fromCol": 0, "toCol": 2 },
    { "id": "rankphase", "label": "Rank + store", "fromCol": 3, "toCol": 3, "variant": "emphasis" },
    { "id": "draftphase", "label": "Draft", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["cron", "fanout", "dedupe", "rank", "ideas", "rss", "draftgen", "posts"],
  "nodes": [
    { "id": "cron", "lane": "trigger", "col": 0, "type": "messagebus", "label": "Discover Refresh", "sublabel": "cron 0 6 * * *", "tag": "or POST /api route", "width": 132 },
    { "id": "fanout", "lane": "collect", "col": 1, "type": "backend", "label": "Source Fan-out", "sublabel": "HN · Reddit · RSS", "width": 132 },
