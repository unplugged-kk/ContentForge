node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz
# Environment files. Everything except the committed examples is ignored.
#
# This was previously the single pattern `.env`, which matched only that exact
# filename — so a backup like `.env.orig-backup` was silently committable. That
# gap is what let real credentials into a local branch. The family is ignored
# now, with the templates explicitly re-included so they stay tracked.
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.local
*.env.*.local

# IDE / AI tooling
.claude/
.cursor/
.codex/

# NOTE: .mcp.json is intentionally TRACKED. It registers the code-review-graph
# and graft MCP servers that AGENTS.md relies on. Keeping it ignored meant every
# fresh clone/worktree silently lost the "use the graph first" tooling.
# Do not add secrets here; it is committed.

# code-review-graph
.code-review-graph/
.graphify_chunks.json
.graphify_python
graphify-out/

# Playwright
e2e/.auth/
test-results/
playwright-report/
playwright/.cache/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# discovery scratch
research/_raw/

# Archify diagrams (docs/architecture): the SPECS (*.json) and the narrated
# guides (*.md) are committed — they are the authoring source. The generated,
# self-contained HTML and the visual-check PNGs are rebuilt from those specs
# (`archify deliver`, see docs/HANDOVER.md §2) and are ~19 MB, so they stay out.
docs/architecture/**/*.html
docs/architecture/**/*.png

# ---------------------------------------------------------------------------
# Local Craft Anything / agent workspace — NOT product code.
#
# One Craft Anything run (2026-11-04 → 11) left its working directory at the repo
# root: browser captures, 32 MB session logs, curl dumps of e2e responses, and a
# copy of another project's Next.js site. None of it is imported by the app, and
# `local.txt` in particular is a libcurl COOKIE JAR containing a live
# `connect.sid` — committing this family is how a session token reaches a remote.
# The files stay on disk; they are only excluded from version control.
#
# The product deliverable of that run is `site/` + `server/site.ts` + the build
# wiring, which ARE tracked.
# ---------------------------------------------------------------------------
/local.txt
/agent-session.jsonl
/build-activity.log
/craft.json
/feed.json
/transcript.json
/usage.json
/art.txt
/art2.txt
# Ad-hoc response dumps captured while verifying the local e2e lifecycle.
/ex.json
/intake.json
/lap.json
/lar.json
/lj.json
/lj2.json
/ljs.json
/ljs2.json
/lop.json
/lreg.json
/lst.json
/lsub.json
/pol.json
/r.json
/rr.json
/run.json
/vg.json
/vg2.json
