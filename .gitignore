node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz
# Environment files. Everything except the committed examples is ignored.
#
# This was previously the single pattern `.env`, which matched only that exact
# filename — so a backup like `.env.orig-backup` was silently committable. That
# gap is what let real credentials into a local branch. The family is ignored
# now, with the templates explicitly re-included so they stay tracked.
.env
.env.*
!.env.example
!.env.*.example
*.env
*.env.local
*.env.*.local

# IDE / AI tooling
.claude/
.cursor/
.codex/
.mcp.json

# code-review-graph
.code-review-graph/
.graphify_chunks.json
.graphify_python
graphify-out/

# Playwright
e2e/.auth/
test-results/
playwright-report/
playwright/.cache/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# discovery scratch
research/_raw/
